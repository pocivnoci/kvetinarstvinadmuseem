# ── Admin (/admin) ──────────────────────────────────────────────────
# Heslo do adminu. Bez něj je admin v produkci nepřístupný;
# při lokálním vývoji (next dev) se bez hesla pustí dál.
ADMIN_PASSWORD=

# ── Databáze (Supabase) ─────────────────────────────────────────────
# Když obě proměnné chybí, admin běží dál, jen si data drží v prohlížeči.
# Obojí najdete v Supabase → Project Settings → API.
#
# POZOR: SUPABASE_SECRET_KEY je tajný klíč, který obchází pravidla
# přístupu k datům. Patří jen sem a do proměnných na Vercelu, nikdy
# do kódu, do repozitáře ani nikam, odkud by ho přečetl prohlížeč.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Čtení faktur z fotky / PDF ──────────────────────────────────────
# Klíč ke Gemini API (aistudio.google.com → Get API key). Bez něj tlačítko
# „Načíst z fotky / PDF" ve Fakturách jen ohlásí, že čtení není zapnuté.
# Stejně jako SUPABASE_SECRET_KEY patří jen sem a do proměnných na Vercelu.
# Projekt musí mít zapnutou fakturaci: na bezplatné úrovni Google faktury
# dodavatelů používá ke zlepšování svých produktů.
GEMINI_API_KEY=
# Nepovinné — jiný model než výchozí gemini-3.5-flash-lite.
GEMINI_MODEL=

# ── Měření ──────────────────────────────────────────────────────────
# ID Meta Pixelu pro /odkazy (nepovinné).
NEXT_PUBLIC_META_PIXEL_ID=
