# ── Admin (/admin) ──────────────────────────────────────────────────
# Heslo do adminu. Bez něj je admin v produkci nepřístupný;
# při lokálním vývoji (next dev) se bez hesla pustí dál.
ADMIN_PASSWORD=

# ── Databáze (Supabase) ─────────────────────────────────────────────
# Když obě proměnné chybí, admin běží dál, jen si data drží v prohlížeči.
# Obojí najdete v Supabase → Project Settings → API.
#
# POZOR: SUPABASE_SECRET_KEY je tajný klíč, který obchází pravidla
# přístupu k datům. Patří jen sem a do proměnných na Vercelu, nikdy
# do kódu, do repozitáře ani nikam, odkud by ho přečetl prohlížeč.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Měření ──────────────────────────────────────────────────────────
# ID Meta Pixelu pro /odkazy (nepovinné).
NEXT_PUBLIC_META_PIXEL_ID=
